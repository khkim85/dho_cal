    "_note": "실제 위경도(WGS84) <-> 게임 지도 step4 픽셀좌표 환산식. 12개 기준도시(리스본,포르투,런던,베네치아,나가사키,포트로열,캘커타,바그다드,자카르타,부에노스아이레스,리우데자네이루,리마)로 최소제곱 피팅. 2026-09-15 산출.",
    "x_from_longitude": {
      "formula": "x = 27.79 * lon_deg + 4697.2",
      "a": 27.79,
      "b": 4697.2,
      "r_squared": 0.99996
    },
    "y_from_latitude_mercator": {
      "formula": "y = -1604.06 * ln(tan(pi/4 + lat_rad/2)) + 2947.3",
      "note": "lat_rad = 위도(degree) * pi/180. 세로축은 단순 선형이 아니라 메르카토르 투영을 따름(R^2가 선형 0.9957 -> 메르카토르 0.9996으로 개선됨).",
      "scale": -1604.06,
      "offset": 2947.3,
      "r_squared": 0.99965
    },
